 speed_firewall_clear() {
+    local iface
+    # SPEED_TC_QOS_V11014:
+    # New speed limiter uses tc/HTB/fq_codel + IFB. Old nft limiter tables
+    # from v1.10.12/v1.10.13 are removed here during upgrade/startup.
     if command -v nft >/dev/null 2>&1; then
         nft delete table inet podkop_tg_speed >/dev/null 2>&1 || true
         nft delete table bridge podkop_tg_speed_bridge >/dev/null 2>&1 || true
         nft delete table netdev podkop_tg_speed_ingress >/dev/null 2>&1 || true
     fi
+    command -v tc >/dev/null 2>&1 || return 0
+    access_lan_ifaces | while IFS= read -r iface; do
+        [ -n "$iface" ] || continue
+        tc qdisc del dev "$iface" root >/dev/null 2>&1 || true
+        tc qdisc del dev "$iface" ingress >/dev/null 2>&1 || true
+        tc qdisc del dev "$iface" clsact >/dev/null 2>&1 || true
+    done
+    if command -v ip >/dev/null 2>&1 && [ -n "$SPEED_IFB_DEV" ]; then
+        tc qdisc del dev "$SPEED_IFB_DEV" root >/dev/null 2>&1 || true
+        ip link set dev "$SPEED_IFB_DEV" down >/dev/null 2>&1 || true
+        ip link delete "$SPEED_IFB_DEV" type ifb >/dev/null 2>&1 || true
+    fi
