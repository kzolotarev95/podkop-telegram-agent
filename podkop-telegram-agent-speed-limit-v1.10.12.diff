+speed_ensure_files() {
+    mkdir -p /etc/podkop-telegram-agent 2>/dev/null || return 1
+    [ -f "$SPEED_RULES_FILE" ] || : > "$SPEED_RULES_FILE"
+    chmod 0600 "$SPEED_RULES_FILE" 2>/dev/null || true
+    return 0
+}
+
+speed_norm_rate() {
+    local raw="$1" v num unit
+    [ -n "$raw" ] || return 1
+    v="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/[[:space:]]//g; s#/s##g; s#/сек##g; s#сек##g; s#байт##g')"
+    v="$(printf '%s' "$v" | sed 's/кбайт/k/g; s/кб/k/g; s/kb/k/g; s/kbyte/k/g; s/kbytes/k/g; s/мбайт/m/g; s/мб/m/g; s/mb/m/g; s/mbyte/m/g; s/mbytes/m/g')"
+    case "$v" in
+        *m) unit="m"; num="${v%m}" ;;
+        *k) unit="k"; num="${v%k}" ;;
+        *) unit="k"; num="$v" ;;
+    esac
+    case "$num" in ''|*[!0-9]*) return 1 ;; esac
+    [ "$num" -gt 0 ] 2>/dev/null || return 1
+    [ "$num" -gt 100000 ] 2>/dev/null && return 1
+    printf '%s%s' "$num" "$unit"
+}
+
+speed_rate_label() {
+    local r="$1" num unit
+    r="$(speed_norm_rate "$r")" || return 1
+    unit="${r##*[0-9]}"
+    num="${r%$unit}"
+    case "$unit" in
+        m) printf '%s МБ/с' "$num" ;;
+        *) printf '%s КБ/с' "$num" ;;
+    esac
+}
+
+speed_rate_nft() {
+    local r="$1" num unit
+    r="$(speed_norm_rate "$r")" || return 1
+    unit="${r##*[0-9]}"
+    num="${r%$unit}"
+    case "$unit" in
+        m) printf '%s mbytes/second' "$num" ;;
+        *) printf '%s kbytes/second' "$num" ;;
+    esac
+}
+
+speed_name_for_ip() {
+    access_name_for_ip "$1" 2>/dev/null || printf 'dev_%s' "$(printf '%s' "$1" | tr . _)"
+}
+
+speed_rule_line_by_ip() {
+    local ip="$1"
+    speed_ensure_files || return 1
+    ip="$(access_normalize_ipv4 "$ip" 2>/dev/null || printf '%s' "$ip")"
+    awk -F'|' -v ip="$ip" '$1 == "1" && $3 == ip { print; found=1; exit } END { if (!found) exit 1 }' "$SPEED_RULES_FILE" 2>/dev/null
+}
+
+speed_active_entries() {
+    local enabled name ip rate mac auto_macs norm_rate one_mac
+    speed_ensure_files || return 1
+    while IFS='|' read -r enabled name ip rate mac rest; do
+        [ "$enabled" = "1" ] || continue
+        access_valid_ipv4 "$ip" || continue
+        ip="$(access_normalize_ipv4 "$ip" 2>/dev/null || printf '%s' "$ip")"
+        norm_rate="$(speed_norm_rate "$rate" 2>/dev/null || true)"
+        [ -n "$norm_rate" ] || continue
+        auto_macs="$mac"
+        [ -z "$auto_macs" ] && auto_macs="$(access_macs_for_ip "$ip" 2>/dev/null || true)"
+        printf '%s||%s\n' "$ip" "$norm_rate"
+        access_all_macs_for_ip "$ip" "$auto_macs" | while IFS= read -r one_mac; do
+            access_valid_mac "$one_mac" && printf '%s|%s|%s\n' "$ip" "$one_mac" "$norm_rate"
+        done
+    done < "$SPEED_RULES_FILE" 2>/dev/null
+}
+
+speed_firewall_clear() {
+    if command -v nft >/dev/null 2>&1; then
+        nft delete table inet podkop_tg_speed >/dev/null 2>&1 || true
+        nft delete table bridge podkop_tg_speed_bridge >/dev/null 2>&1 || true
+        nft delete table netdev podkop_tg_speed_ingress >/dev/null 2>&1 || true
+    fi
+}
+
+speed_nft_add_limit_rule() {
+    local family="$1" table="$2" chain="$3" ip="$4" mac="$5" rate="$6" nft_rate ok=1
+    nft_rate="$(speed_rate_nft "$rate" 2>/dev/null)" || return 1
+    if access_valid_ipv4 "$ip"; then
+        nft add rule "$family" "$table" "$chain" ip saddr "$ip" limit rate over $nft_rate counter drop >/dev/null 2>&1 && ok=0
+        nft add rule "$family" "$table" "$chain" ip daddr "$ip" limit rate over $nft_rate counter drop >/dev/null 2>&1 && ok=0
+    fi
+    if access_valid_mac "$mac"; then
+        nft add rule "$family" "$table" "$chain" ether saddr "$mac" limit rate over $nft_rate counter drop >/dev/null 2>&1 && ok=0
+        nft add rule "$family" "$table" "$chain" ether daddr "$mac" limit rate over $nft_rate counter drop >/dev/null 2>&1 && ok=0
+    fi
+    return "$ok"
+}
+
+speed_nft_add_ingress_limit_rule() {
+    local family="$1" table="$2" chain="$3" ip="$4" mac="$5" rate="$6" nft_rate ok=1
+    nft_rate="$(speed_rate_nft "$rate" 2>/dev/null)" || return 1
+    if access_valid_ipv4 "$ip"; then
+        nft add rule "$family" "$table" "$chain" ip saddr "$ip" limit rate over $nft_rate counter drop >/dev/null 2>&1 && ok=0
+    fi
+    if access_valid_mac "$mac"; then
+        nft add rule "$family" "$table" "$chain" ether saddr "$mac" limit rate over $nft_rate counter drop >/dev/null 2>&1 && ok=0
+    fi
+    return "$ok"
+}
+
+speed_firewall_apply_file() {
+    local file="$1" ip mac rate rc=1 added=0 iface chain
+    speed_firewall_clear
+    [ -s "$file" ] || return 0
+    command -v nft >/dev/null 2>&1 || return 1
+
+    if access_nft_add_table inet podkop_tg_speed; then
+        access_nft_create_chain inet podkop_tg_speed prerouting prerouting -420 || true
+        access_nft_create_chain inet podkop_tg_speed forward forward -420 || true
+        access_nft_create_chain inet podkop_tg_speed output output -420 || true
+        while IFS='|' read -r ip mac rate; do
+            [ -n "$ip" ] || continue
+            for chain in prerouting forward output; do
+                if nft list chain inet podkop_tg_speed "$chain" >/dev/null 2>&1; then
+                    speed_nft_add_limit_rule inet podkop_tg_speed "$chain" "$ip" "$mac" "$rate" && added=$((added + 1))
+                fi
+            done
+        done < "$file"
+    fi
+
+    if access_nft_add_table bridge podkop_tg_speed_bridge; then
+        access_nft_create_chain bridge podkop_tg_speed_bridge prerouting prerouting -420 || true
+        access_nft_create_chain bridge podkop_tg_speed_bridge forward forward -420 || true
+        while IFS='|' read -r ip mac rate; do
+            [ -n "$ip" ] || continue
+            for chain in prerouting forward; do
+                if nft list chain bridge podkop_tg_speed_bridge "$chain" >/dev/null 2>&1; then
+                    speed_nft_add_limit_rule bridge podkop_tg_speed_bridge "$chain" "$ip" "$mac" "$rate" && added=$((added + 1))
+                fi
+            done
+        done < "$file"
+    fi
+
+    if access_nft_add_table netdev podkop_tg_speed_ingress; then
+        access_lan_ifaces | while IFS= read -r iface; do
+            [ -n "$iface" ] || continue
+            chain="$(access_nft_iface_chain_name "$iface")"
+            nft list chain netdev podkop_tg_speed_ingress "$chain" >/dev/null 2>&1 || \
+                nft "add chain netdev podkop_tg_speed_ingress $chain { type filter hook ingress device \"$iface\" priority -420; policy accept; }" >/dev/null 2>&1 || true
+            if nft list chain netdev podkop_tg_speed_ingress "$chain" >/dev/null 2>&1; then
+                while IFS='|' read -r ip mac rate; do
+                    [ -n "$ip" ] || continue
+                    speed_nft_add_ingress_limit_rule netdev podkop_tg_speed_ingress "$chain" "$ip" "$mac" "$rate" && echo ok >/tmp/podkop_tg_speed_added_$$
+                done < "$file"
+            fi
+        done
+        if [ -f /tmp/podkop_tg_speed_added_$$ ]; then
+            added=$((added + 1))
+            rm -f /tmp/podkop_tg_speed_added_$$ 2>/dev/null || true
+        fi
+    fi
+
+    [ "$added" -gt 0 ] 2>/dev/null && rc=0
+    return "$rc"
+}
+
+speed_apply() {
+    local tmp state old rc
+    if [ "$SPEED_CONTROL" != "1" ]; then
+        speed_firewall_clear
+        return 0
+    fi
+    speed_ensure_files || return 1
+    tmp="/tmp/podkop_tg_speed_entries_$$"
+    speed_active_entries | awk -F'|' 'NF { k=$1 "|" $2 "|" $3; if ($1 != "" && !seen[k]++) print $0 }' > "$tmp"
+    speed_firewall_apply_file "$tmp"
+    rc=$?
+    state="$(awk -F'|' 'NF && $1 != "" { if (!seen[$1]++) printf "%s=%s ", $1, $3 }' "$tmp" 2>/dev/null | sed 's/[[:space:]]*$//')"
+    old="$(cat "$SPEED_LAST_FILE" 2>/dev/null)"
+    if [ "$state" != "$old" ]; then
+        log "speed limit applied backend=nft rules=${state:-none}"
+        printf '%s\n' "$state" > "$SPEED_LAST_FILE"
+    fi
+    rm -f "$tmp"
+    return "$rc"
+}
+
+speed_set_limit_by_ip() {
+    local ip="$1" rate="$2" name mac tmp norm_rate
+    access_valid_ipv4 "$ip" || return 3
+    ip="$(access_normalize_ipv4 "$ip" 2>/dev/null || printf '%s' "$ip")"
+    norm_rate="$(speed_norm_rate "$rate")" || return 4
+    name="$(speed_name_for_ip "$ip")"
+    mac="$(access_macs_for_ip "$ip" 2>/dev/null || true)"
+    speed_ensure_files || return 1
+    tmp="/tmp/podkop_tg_speed_rules_$$"
+    awk -F'|' -v ip="$ip" '$3 != ip { print }' "$SPEED_RULES_FILE" > "$tmp" 2>/dev/null || true
+    printf '1|%s|%s|%s|%s\n' "$name" "$ip" "$norm_rate" "$mac" >> "$tmp"
+    mv "$tmp" "$SPEED_RULES_FILE" || return 1
+    chmod 0600 "$SPEED_RULES_FILE" 2>/dev/null || true
+    speed_apply
+}
+
+speed_delete_limit_by_ip() {
+    local ip="$1" tmp
+    access_valid_ipv4 "$ip" || return 3
+    ip="$(access_normalize_ipv4 "$ip" 2>/dev/null || printf '%s' "$ip")"
+    speed_ensure_files || return 1
+    tmp="/tmp/podkop_tg_speed_rules_$$"
+    awk -F'|' -v ip="$ip" '$3 != ip { print }' "$SPEED_RULES_FILE" > "$tmp" 2>/dev/null || true
+    mv "$tmp" "$SPEED_RULES_FILE" || return 1
+    speed_apply
+}
+
+speed_rules_text() {
+    local name ip rate label enabled mac rest out found
+    speed_ensure_files || true
+    found=0
+    out=""
+    while IFS='|' read -r enabled name ip rate mac rest; do
+        [ "$enabled" = "1" ] || continue
+        access_valid_ipv4 "$ip" || continue
+        label="$(speed_rate_label "$rate" 2>/dev/null || printf '%s' "$rate")"
+        found=$((found + 1))
+        out="${out}• <b>$(printf '%s' "${name:-device}" | escape_html)</b> — <code>$(printf '%s' "$ip" | escape_html)</code> → <code>$(printf '%s' "$label" | escape_html)</code>\n"
+    done < "$SPEED_RULES_FILE" 2>/dev/null
+    if [ "$found" = "0" ]; then
+        printf 'Активных лимитов нет.\n'
+    else
+        printf '%b' "$out"
+    fi
+}
+
+speed_static_devices_text() {
+    local name macs ip lease_name lease_mac active rule rate label shown
+    shown=0
+    access_static_devices | while IFS='|' read -r name macs ip lease_name lease_mac active; do
+        [ -n "$ip" ] || continue
+        shown=$((shown + 1))
+        [ "$shown" -gt 20 ] && continue
+        rule="$(speed_rule_line_by_ip "$ip" 2>/dev/null || true)"
+        rate="$(printf '%s' "$rule" | awk -F'|' '{ print $4 }')"
+        label="без лимита"
+        [ -n "$rate" ] && label="$(speed_rate_label "$rate" 2>/dev/null || printf '%s' "$rate")"
+        printf '• <b>%s</b> — <code>%s</code> — <code>%s</code> — %s\n' \
+            "$(printf '%s' "${name:-device}" | escape_html)" \
+            "$(printf '%s' "$ip" | escape_html)" \
+            "$(printf '%s' "${active:-unknown}" | escape_html)" \
+            "$(printf '%s' "$label" | escape_html)"
+    done
+}
