+    [ -z "$macs" ] && macs="$lease_mac"
+    [ -z "$active" ] && active="unknown"
+    rule="$(speed_rule_line_by_ip "$ip" 2>/dev/null || true)"
+    rate="$(printf '%s' "$rule" | awk -F'|' '{ print $4 }')"
