+    line="$(access_static_device_by_ip "$ip" 2>/dev/null || true)"
+    name="$(printf '%s' "$line" | awk -F'|' '{ print $1 }')"
+    macs="$(printf '%s' "$line" | awk -F'|' '{ print $2 }')"
+    lease_mac="$(printf '%s' "$line" | awk -F'|' '{ print $5 }')"
+    active="$(printf '%s' "$line" | awk -F'|' '{ print $6 }')"
