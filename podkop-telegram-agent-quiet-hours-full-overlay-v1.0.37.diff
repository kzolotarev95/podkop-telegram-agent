+    [ "$start" = "$end" ] && return 1
+    now_m="$(time_to_minutes "$now")"
+    start_m="$(time_to_minutes "$start")"
+    end_m="$(time_to_minutes "$end")"
+    if [ "$start_m" -lt "$end_m" ] 2>/dev/null; then
+        [ "$now_m" -ge "$start_m" ] 2>/dev/null && [ "$now_m" -lt "$end_m" ] 2>/dev/null
