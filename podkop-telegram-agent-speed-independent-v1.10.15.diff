+speed_flow_offload_disable_if_needed() {
+    # SPEED_TC_INDEPENDENT_V11015:
+    # Flow offloading can bypass tc/SQM rules after Podkop or firewall reloads.
+    # While speed limits are active, disable software/hardware flow offload so
+    # traffic always goes through the shaper. We do not re-enable it automatically.
+    command -v uci >/dev/null 2>&1 || return 0
+    uci -q show firewall >/dev/null 2>&1 || return 0
+
+    local changed=0 cur
+    cur="$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null || true)"
+    if [ "$cur" = "1" ]; then
+        uci -q set firewall.@defaults[0].flow_offloading='0' && changed=1
+    fi
+    cur="$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null || true)"
+    if [ "$cur" = "1" ]; then
+        uci -q set firewall.@defaults[0].flow_offloading_hw='0' && changed=1
+    fi
+    cur="$(uci -q get firewall.@defaults[0].hw_flow_offloading 2>/dev/null || true)"
+    if [ "$cur" = "1" ]; then
+        uci -q set firewall.@defaults[0].hw_flow_offloading='0' && changed=1
+    fi
+
+    if [ "$changed" = "1" ]; then
+        uci -q commit firewall >/dev/null 2>&1 || true
+        /etc/init.d/firewall reload >/tmp/podkop_tg_speed_firewall_reload.log 2>&1 || true
+        log "speed limit disabled firewall flow offloading so tc/SQM limits cannot be bypassed by Podkop/firewall offload"
+    fi
+}
+
+speed_tc_clean_old_nft() {
+    # Remove obsolete v1.10.12/v1.10.13 nft limit tables.
+    if command -v nft >/dev/null 2>&1; then
+        nft delete table inet podkop_tg_speed >/dev/null 2>&1 || true
+        nft delete table bridge podkop_tg_speed_bridge >/dev/null 2>&1 || true
+        nft delete table netdev podkop_tg_speed_ingress >/dev/null 2>&1 || true
+    fi
+}
+
 speed_tc_apply_file() {
     local file="$1" unique iface ip rate classid added=0 ifb_ok=1
+    speed_tc_clean_old_nft
+    [ -s "$file" ] && speed_flow_offload_disable_if_needed
     speed_firewall_clear
     [ -s "$file" ] || return 0
     speed_tc_have || return 2
