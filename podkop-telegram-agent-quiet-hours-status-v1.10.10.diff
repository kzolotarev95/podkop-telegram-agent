+quiet_hours_mode() {
+    case "${ALERT_QUIET_MODE:-queue}" in
+        drop) printf 'drop' ;;
+        *) printf 'queue' ;;
+    esac
+}
+
+quiet_hours_mode_human() {
+    case "$(quiet_hours_mode)" in
+        drop) printf 'подавлять' ;;
+        *) printf 'отложить до утра' ;;
+    esac
