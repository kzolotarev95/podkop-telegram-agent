+    var mode = uci.get('podkop_tg', section_id, 'alert_quiet_mode') || 'queue';
+    if (enabled === '0')
+        return _('выключены, сейчас не активно');
+    return start + '-' + end + ', ' + quietModeHuman(mode) + ', ' + (quietActiveNow(start, end) ? _('сейчас активно') : _('сейчас не активно'));
+}
