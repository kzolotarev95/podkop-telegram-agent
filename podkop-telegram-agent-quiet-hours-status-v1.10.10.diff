+quiet_hours_window_text() {
+    printf '%s-%s' "$(normalize_daily_report_time "${ALERT_QUIET_START:-23:00}")" "$(normalize_daily_report_time "${ALERT_QUIET_END:-08:00}")"
+}
+
+quiet_hours_active() {
+    local now start end now_m start_m end_m
+    [ "${ALERT_QUIET_HOURS:-1}" = "1" ] || return 1
+    now="$(date '+%H:%M')"
+    start="$(normalize_daily_report_time "${ALERT_QUIET_START:-23:00}")"
+    end="$(normalize_daily_report_time "${ALERT_QUIET_END:-08:00}")"
+    [ "$start" = "$end" ] && return 1
+    now_m="$(time_to_minutes "$now")"
+    start_m="$(time_to_minutes "$start")"
+    end_m="$(time_to_minutes "$end")"
+    if [ "$start_m" -lt "$end_m" ] 2>/dev/null; then
+        [ "$now_m" -ge "$start_m" ] 2>/dev/null && [ "$now_m" -lt "$end_m" ] 2>/dev/null
+        return $?
+    fi
+    [ "$now_m" -ge "$start_m" ] 2>/dev/null || [ "$now_m" -lt "$end_m" ] 2>/dev/null
+}
+
+quiet_hours_active_human() {
+    if quiet_hours_active; then
+        printf 'сейчас активно'
+    else
+        printf 'сейчас не активно'
+    fi
+}
+
+quiet_hours_status_text() {
+    if [ "${ALERT_QUIET_HOURS:-1}" != "1" ]; then
+        printf 'выключены, сейчас не активно'
+        return
+    fi
+    printf '%s, %s, %s' "$(quiet_hours_window_text)" "$(quiet_hours_mode_human)" "$(quiet_hours_active_human)"
 }
 
