+        if ! send_help_api_message "$chat" "$header
+━━━━━━━━━━━━━━━━━━━━━━━━━━━
+$(cat "$part")" "$i" "$with_keyboard"; then
+            rc=1
+            log "help send failed part=$i chunks=$chunks see=/tmp/podkop_tg_help_v11011.${i}.log"
+        else
+            log "help sent part=$i chunks=$chunks"
+        fi
+        i=$((i + 1))
+        sleep 1
+    done
+    rm -f "$tmp.body" "$tmp.part."* 2>/dev/null || true
+    return "$rc"
+}
