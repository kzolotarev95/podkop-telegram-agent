+send_help_api_message() {
+    local chat="$1" text="$2" part="$3" with_keyboard="${4:-0}" resp logf
+    [ -z "$TOKEN" ] && return 1
+    [ -z "$chat" ] && return 1
+    logf="/tmp/podkop_tg_help_v11011.${part}.log"
+    rm -f "$logf" 2>/dev/null || true
+    if [ "$with_keyboard" = "1" ]; then
+        resp="$(curl -sS --max-time 20 -X POST "$API/sendMessage" \
+            --data-urlencode "chat_id=$chat" \
+            --data-urlencode "text=$text" \
+            --data-urlencode "disable_web_page_preview=true" \
+            --data-urlencode "reply_markup=$(keyboard_json)" 2>&1)"
+    else
+        resp="$(curl -sS --max-time 20 -X POST "$API/sendMessage" \
+            --data-urlencode "chat_id=$chat" \
+            --data-urlencode "text=$text" \
+            --data-urlencode "disable_web_page_preview=true" 2>&1)"
+    fi
+    printf '%s\n' "$resp" > "$logf"
+    printf '%s\n' "$resp" > /tmp/podkop_tg_help_v11011.log
+    printf '%s' "$resp" | grep -q '"ok"[[:space:]]*:[[:space:]]*true'
+}
+
+send_help_text() {
+    local chat="$1" tmp line current file chunks i header rc part with_keyboard
+    [ -z "$TOKEN" ] && return 1
