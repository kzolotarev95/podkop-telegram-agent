+speed_flowtables_flush() {
+    local table ft
+    # SPEED_WATCHDOG_V11013:
+    # OpenWrt flow offload can bypass later nft rules for already established
+    # traffic, so speed limits may appear to work only for the first seconds.
+    # Flush flowtables while any speed rule is active. This does not delete
+    # connections, it only forces packets back through nft hooks.
+    command -v nft >/dev/null 2>&1 || return 0
+    for table in fw4 firewall; do
+        nft list table inet "$table" >/tmp/podkop_tg_speed_ft_$$ 2>/dev/null || continue
+        awk '/^[[:space:]]*flowtable[[:space:]]+/ { print $2 }' /tmp/podkop_tg_speed_ft_$$ 2>/dev/null | while IFS= read -r ft; do
+            [ -n "$ft" ] || continue
+            nft flush flowtable inet "$table" "$ft" >/dev/null 2>&1 || true
+        done
+    done
+    rm -f /tmp/podkop_tg_speed_ft_$$ 2>/dev/null || true
+}
+
+speed_conntrack_cleanup_file() {
+    local file="$1" ip
+    # On first applying a limit, remove existing conntrack entries for that IP
+    # so an already-open speedtest/download cannot keep old/offloaded state.
+    if command -v conntrack >/dev/null 2>&1; then
+        awk -F'|' 'NF && $1 != "" && !seen[$1]++ { print $1 }' "$file" 2>/dev/null | while IFS= read -r ip; do
+            access_valid_ipv4 "$ip" || continue
+            conntrack -D -s "$ip" >/dev/null 2>&1 || true
+            conntrack -D -d "$ip" >/dev/null 2>&1 || true
+        done
+    fi
+    speed_flowtables_flush
+}
+
+speed_firewall_tables_present() {
+    command -v nft >/dev/null 2>&1 || return 1
+    nft list table inet podkop_tg_speed >/dev/null 2>&1 || return 1
+    return 0
+}
