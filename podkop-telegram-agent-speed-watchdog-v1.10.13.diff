+speed_watchdog_tick() {
+    local tmp now last age rc before_present
+    [ "$SPEED_CONTROL" = "1" ] || {
+        speed_firewall_clear >/dev/null 2>&1 || true
+        return 0
+    }
+    speed_ensure_files || return 1
+    tmp="/tmp/podkop_tg_speed_watchdog_$$"
+    speed_active_entries | awk -F'|' 'NF { k=$1 "|" $2 "|" $3; if ($1 != "" && !seen[k]++) print $0 }' > "$tmp"
+
+    if [ ! -s "$tmp" ]; then
+        speed_firewall_clear >/dev/null 2>&1 || true
+        rm -f "$tmp"
+        return 0
+    fi
+
+    now="$(date +%s 2>/dev/null || echo 0)"
+    last="$(cat "$SPEED_LAST_APPLY_FILE" 2>/dev/null || echo 0)"
+    case "$last" in ''|*[!0-9]*) last=0 ;; esac
+    age=$((now - last))
+
+    before_present=1
+    speed_firewall_tables_present && before_present=0
+
+    # Re-apply if firewall/podkop/firewall4 reload removed our private table,
+    # or periodically to refresh changed static MAC bindings. Between re-applies
+    # only flush flowtables to prevent flow-offload bypass.
+    if [ "$before_present" != "0" ] || [ "$age" -ge 60 ] 2>/dev/null; then
+        speed_firewall_apply_file "$tmp"
+        rc=$?
+        if [ "$rc" = "0" ]; then
+            speed_flowtables_flush >/dev/null 2>&1 || true
+            date +%s > "$SPEED_LAST_APPLY_FILE" 2>/dev/null || true
+            if [ "$before_present" != "0" ]; then
+                log "speed watchdog refreshed backend=nft reason=missing_table"
+            else
+                log "speed watchdog refreshed backend=nft reason=periodic"
+            fi
+        fi
+    else
+        speed_flowtables_flush >/dev/null 2>&1 || true
+    fi
+
+    rm -f "$tmp"
+    return 0
+}
